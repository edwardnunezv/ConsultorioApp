@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary">ConsultorioApp</h1>
            <p class="col-md-8 fs-4 text-muted">Sistema local de gestión de historias clínicas y control ginecológico.</p>
            <hr class="my-4">
            <p>Acceda rápidamente al registro de pacientes o comience una nueva consulta médica.</p>
            <div class="d-flex gap-3 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Pacientes" asp-action="Index">Ver Listado de Pacientes</a>
                <a class="btn btn-outline-success btn-lg" asp-controller="Pacientes" asp-action="Create">+ Registrar Nueva Paciente</a>
            </div>
        </div>
    </div>
</div>