@model IEnumerable<ConsultorioApp.Models.Paciente>

@{
    ViewData["Title"] = "Gestión de Pacientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Pacientes</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nueva Paciente</a>
    </div>

    <!-- Barra de Búsqueda -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar por nombre, apellido o DNI..." value="@Context.Request.Query["buscar"]" />
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-dark">Limpiar</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Apellidos y Nombres</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Fecha de Registro</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><strong>@item.Apellido, @item.Nombre</strong></td>
                            <td>@item.Dni</td>
                            <td>@(string.IsNullOrEmpty(item.Telefono) ? "No registrado" : item.Telefono)</td>
                            <td>@item.FechaNacimiento.ToShortDateString()</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Historia Clínica</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>